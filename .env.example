# Runtime
NODE_ENV=development
PORT=3001
FRONTEND_PORT=3000
FRONTEND_URL=http://localhost:3000

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ai_productivity_hub
DB_USER=postgres
DB_PASSWORD=change-me
DB_SSL=false
# DATABASE_URL=postgresql://postgres:change-me@localhost:5432/ai_productivity_hub

# Authentication (required; generate a long random value)
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_PREVIOUS_SECRET=
JWT_ISSUER=ai-productivity-hub
JWT_AUDIENCE=ai-productivity-hub-web
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d

# AI provider
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-3-5-sonnet-20241022

# Google Calendar OAuth
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

# Personal OAuth credentials are assigned to exactly one local user.
INTEGRATION_OWNER_USER_ID=

# Microsoft Graph / Outlook OAuth
OUTLOOK_TENANT_ID=common
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
OUTLOOK_REFRESH_TOKEN=

# Google Fit delegated access
GOOGLE_FIT_ACCESS_TOKEN=

# Slack incoming webhook
SLACK_WEBHOOK_URL=

# SMTP
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Demo-only token disclosure. Never enable in production.
EXPOSE_DEMO_TOKENS=false

# Required only by the explicit scripts/seed-demo.sh command.
DEMO_ADMIN_PASSWORD=
DEMO_USER_PASSWORD=
# Local-only demo autofill. The ignored .env must provide one complete
# DEMO_*, SEED_ADMIN_*, ADMIN_*, or DEFAULT_* email/password pair.
ENABLE_DEMO_CREDENTIAL_AUTOFILL=false
